---
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
import Logo from '../components/Logo.astro';
import Mascota from '../components/Mascota.astro';
import Seccion from '../components/Seccion.astro';
import Ventana from '../components/Ventana.astro';
import BotonStart from '../components/BotonStart.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import CabeceraSaga from '../components/CabeceraSaga.astro';
import Paleta from '../components/Paleta.astro';
import Emote from '../components/Emote.astro';
import DemoNfc from '../components/DemoNfc.astro';
import Capsula from '../components/Capsula.astro';
import TarjetaColeccionista from '../components/TarjetaColeccionista.astro';
import Entregas from '../components/Entregas.astro';
import marca from '../config/marca.json';
import { destacados, getSagas, productosPorSaga, precioDesde, getProducto } from '../lib/catalogo';
import { getTianguisActivos } from '../lib/tianguis';
import regalos from '../data/regalos.json';

const fichas = destacados();
const sagas = getSagas();
const desde = precioDesde();
const puestos = getTianguisActivos();
const redes = Object.entries(marca.redes).filter(([, url]) => url);
const promo = marca.promocion;
---
<Base titulo={marca.lema} descripcion={`Llaveros impresos en 3D con chip NFC, estilo retro y anime, desde $${desde}. Pide por WhatsApp o búscanos en el tianguis.`}>
  <Marca slot="logo" />

  <section id="inicio" class="hero scanlines speedlines" aria-labelledby="inicio-titulo">
    <div class="contenedor hero__cuerpo">
      <div class="hero__texto">
        <Mascota estado="saluda" tamano={96} alt={`${marca.mascota}, la mascota de ${marca.marca}, saludando`} />
        <h1 id="inicio-titulo">Elige tu llavero</h1>
        <p class="hero__lema">Impresos en 3D aquí en {marca.ciudad}. Con chip NFC si quieres que hagan algo más que colgar.</p>
        <p class="pixel hero__desde">Desde ${desde}</p>
        <BotonStart href="#catalogo" />
        <p id="start-aviso" class="hero__aviso" role="status" hidden></p>
      </div>
      <div class="hero__logo"><Logo alto={150} /></div>
    </div>
    <div class="contenedor">
      <p class="pixel" style="font-size:.5rem;margin-bottom:.25rem">Selecciona tu personaje</p>
      <div class="fichas">
        {fichas.map(p => (
          <a class="ficha" href={`/llavero/${p.slug}`}>
            <span class="ficha__img"><img src={p.imagen || `/img/placeholders/${p.saga}.svg`} alt="" width="132" height="132" loading="lazy" /></span>
            <span class="ficha__nombre">{p.nombre}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Seccion id="nfc" titulo="Con poder NFC" subtitulo="Acércalo al celular y pasa algo. Sin pilas, sin app rara, sin que le reces.">
    <Emote slot="emote" tipo="brillo" />
    <div class="nfc">
      <Ventana titulo="Así funciona" tono="verde"><DemoNfc /></Ventana>
      <Ventana titulo="Tres ideas" tono="verde">
        <ul class="lista-poder">
          <li><b>Wi-Fi de tu casa.</b> Las visitas tocan el llavero y ya están conectadas.</li>
          <li><b>Tu WhatsApp o tus redes.</b> Lo acercan y te escriben, sin dictar números.</li>
          <li><b>Placa de tu mascota.</b> Si se pierde, quien la encuentre ve tu teléfono.</li>
        </ul>
        <p>Tú lo programas desde tu cel las veces que quieras. Te enseñamos paso a paso.</p>
        <a class="btn" href="/activa">Ver el instructivo</a>
      </Ventana>
    </div>
  </Seccion>

  <Seccion id="catalogo" titulo="Catálogo por sagas" subtitulo="Cada diseño tiene su precio según tamaño. Todos se piden por WhatsApp.">
    {sagas.map(s => (
      <div class="saga" aria-labelledby={`saga-${s.slug}`}>
        <CabeceraSaga saga={s} />
        <div class="grid">{productosPorSaga(s.slug).map(p => <TarjetaProducto producto={p} />)}</div>
      </div>
    ))}
  </Seccion>


  <Seccion id="hazlo-tuyo" titulo="Hazlo tuyo" subtitulo="Tres formas de personalizar, sin letra chiquita." fondo="halftone">
    <Emote slot="emote" tipo="sorpresa" />
    <div class="grid grid--ancho">
      <Ventana titulo="Editable">
        <p>Los diseños con la etiqueta <span class="etiqueta etiqueta--editable">Editable</span> se pueden adaptar: tu nombre o texto, y cambio de colores.</p>
        <p>Me escribes por WhatsApp con el diseño, el nombre y los colores que quieres. Yo lo edito y te mando una foto de cómo queda antes de imprimirlo.</p>
      </Ventana>
      <Ventana titulo="Colores" tono="amarillo">
        <p>Cada llavero se imprime con máximo cuatro colores. Cada diseño ya trae su número de colores, y ese número no cambia: puedes elegir cuáles, no cuántos.</p>
        <p>Un diseño de dos colores sigue siendo de dos colores, solo que con los que tú escojas. Estos son los que tengo:</p>
        <Paleta />
      </Ventana>
      <Ventana titulo="Diseño nuevo" tono="rojo">
        <p>Si quieres algo que no está en el catálogo, se cotiza aparte. El precio depende del tamaño y del número de colores.</p>
        <p>Mándame la idea o una referencia por WhatsApp y te digo cuánto y cuándo.</p>
        <BotonWhatsApp tipo="nuevo" texto="Cotizar diseño nuevo" />
      </Ventana>
    </div>
  </Seccion>

  <Seccion id="donde" titulo="¿Dónde estamos esta semana?" subtitulo="Ven al puesto, tócalos y llévatelo en la mano.">
    <Emote slot="emote" tipo="gota" />
    {puestos.length ? (
      <ul class="puestos">
        {puestos.map(p => (
          <li class="puesto">
            <span class="puesto__dia">{p.dia}</span>
            <span class="puesto__lugar">{p.lugar}{p.zona && `, ${p.zona}`}</span>
            <span class="puesto__detalle">{p.horario}{p.nota && ` · ${p.nota}`}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>Esta semana descansamos. Escríbenos y te decimos dónde caemos.</p>
    )}
    <div class="acciones">
      <BotonWhatsApp tipo="avisame" texto="Avísame cuando andes cerca" />
      <a class="btn btn--fantasma" href="/donde">Ver todos los puestos</a>
    </div>
  </Seccion>

  <Seccion id="entregas" titulo="Entregas y envíos" subtitulo="Recoges gratis, te lo llevo o te lo mando. Tú eliges al pedir.">
    <Entregas />
  </Seccion>

  <Seccion id="regalos" titulo="Guía de regalos" subtitulo="Para cuando no sabes qué llevar y no quieres llegar con las manos vacías." fondo="halftone">
    <div class="grid grid--ancho">
      {regalos.map(r => (
        <Ventana titulo={`Para ${r.para.toLowerCase()}`} tono="rojo">
          <p>{r.texto}</p>
          <ul class="regalo-lista">
            {r.productos.map(slug => { const p = getProducto(slug); return p ? <li><a href={`/llavero/${p.slug}`}>{p.nombre}</a> <small>desde ${p.precio_basico}</small></li> : null; })}
          </ul>
        </Ventana>
      ))}
    </div>
  </Seccion>

  {promo.activa && (
    <Seccion id="promo" titulo={promo.titulo} subtitulo={`Cada pedido desde esta página suma un sello: al ${promo.sellos_llavero}° te llevas un llavero con tu nombre gratis, y al ${promo.sellos_capsula}° abres la cápsula.`} fondo="halftone">
      <Emote slot="emote" tipo="brillo" />
      <div class="promo">
        <Ventana titulo={`Sello ${promo.sellos_llavero}: llavero con tu nombre`} tono="verde">
          <div class="promo__nivel">
            <TarjetaColeccionista sellos={promo.sellos_llavero} total={promo.sellos_capsula} />
          </div>
          <p>En tu pedido número {promo.sellos_llavero} te llevas gratis un llavero de la <a href="/saga/nombre">Saga Con Nombre</a>, básico, con el nombre que tú digas.</p>
        </Ventana>
        <Ventana titulo={`Sello ${promo.sellos_capsula}: abre la cápsula`} tono="rojo">
          <div class="promo__nivel">
            <Capsula tamano={110} abierta gira={false} />
            <p>En tu compra número {promo.sellos_capsula} abres la cápsula sorpresa y te llevas un modelo al azar, gratis. No sabes cuál te toca. Esa es la gracia.</p>
          </div>
        </Ventana>
        <p class="promo__nota"><b>{promo.requisito}</b> {promo.nota}</p>
      </div>
    </Seccion>
  )}



  <Fragment slot="pie">
    {redes.map(([red, url]) => <a href={url} target="_blank" rel="noopener" style="text-transform:capitalize">{red}</a>)}
    <a href="/activa">Activa tu llavero</a>
  </Fragment>

  <div slot="flotante" class="btn-flotante">
    <BotonWhatsApp tipo="hola" texto="Continuar ▶ WhatsApp" class="btn btn--wa" />
  </div>

  <div slot="flotante" id="pantalla-start" class="start-pantalla scanlines" hidden aria-live="assertive">
    <div class="start-pantalla__cartucho" aria-hidden="true">
      <svg viewBox="0 0 64 80" width="96" height="120" shape-rendering="crispEdges">
        <rect x="4" y="0" width="56" height="76" fill="var(--gb-3)" /><rect x="8" y="4" width="48" height="68" fill="var(--gb-1)" />
        <rect x="16" y="12" width="32" height="28" fill="var(--rojo)" /><rect x="20" y="16" width="24" height="6" fill="var(--fondo)" /><rect x="20" y="26" width="16" height="6" fill="var(--fondo)" />
        <rect x="12" y="56" width="40" height="12" fill="var(--gb-0)" />
      </svg>
    </div>
    <p class="pixel start-pantalla__linea" data-linea>PLAYER 1</p>
    <p class="start-pantalla__pie">{marca.marca} · {marca.lema}</p>
  </div>
</Base>

<style>
  .hero { padding-block: clamp(1.5rem, 5vw, 3.5rem) 1rem; border-bottom: 3px solid var(--borde); }
  .hero__cuerpo { display: grid; gap: 1.5rem; align-items: center; margin-bottom: 1.5rem; }
  @media (min-width: 760px) { .hero__cuerpo { grid-template-columns: 1.2fr 1fr; } .hero__logo { justify-self: end; } }
  .hero__logo { display: none; }
  @media (min-width: 760px) { .hero__logo { display: block; } }
  .hero__lema { font-size: 1.1rem; max-width: 40ch; }
  .hero__desde { font-size: .8rem; color: var(--rojo); margin-bottom: 1.25rem; }
  .nfc { display: grid; gap: 1.25rem; }
  @media (min-width: 760px) { .nfc { grid-template-columns: auto 1fr; align-items: start; } }
  .lista-poder { padding-left: 1.1rem; margin: 0 0 1rem; }
  .lista-poder li { margin-bottom: .5rem; }
  .saga + .saga { margin-top: 2.5rem; }
  .regalo-lista { padding-left: 1.1rem; margin: 0; }
  .promo { display: grid; gap: 1.25rem; }
  @media (min-width: 760px) { .promo { grid-template-columns: 1fr 1fr; align-items: start; } }
  .promo__nivel { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; }
  .promo__num { font-family: var(--fuente-pixel); font-size: 1.4rem; color: var(--rojo); }
  .promo__nota { grid-column: 1 / -1; color: var(--tinta-suave); font-size: .9rem; }
  .hero__aviso { margin-top: .75rem; font-size: .9rem; color: var(--tinta-suave); }
</style>
<script src="../scripts/start.ts"></script>
