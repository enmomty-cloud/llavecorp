---
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
import Ventana from '../components/Ventana.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Mascota from '../components/Mascota.astro';
import marca from '../config/marca.json';
import { getMayoreo } from '../lib/tianguis';

const rangos = getMayoreo();
const cantidad = (r: { desde: number; hasta: number | null }) => (r.hasta === null ? `${r.desde} o más` : `${r.desde} a ${r.hasta}`);
---
<Base titulo="Vende con nosotros" descripcion={`Precios de mayoreo de llaveros ${marca.marca} para amigos, familia y revendedores.`}>
  <Marca slot="logo" />
  <section class="contenedor seccion" aria-labelledby="mayoreo-titulo">
    <div class="mayoreo-cab">
      <Mascota estado="poder" tamano={72} />
      <div>
        <h1 id="mayoreo-titulo">Vende con nosotros</h1>
        <p>Si quieres vender llaveros {marca.marca} con tus amigos, en tu escuela, en tu trabajo o en tu propio puesto, hay precio de mayoreo desde 10 piezas. Puedes mezclar diseños.</p>
      </div>
    </div>
    <Ventana titulo="Precio por pieza" tono="verde">
      <table class="tabla">
        <caption>Precios por cantidad, en pesos</caption>
        <thead>
          <tr><th scope="col">Piezas</th><th scope="col">Básico</th><th scope="col">Con NFC</th><th scope="col">Nota</th></tr>
        </thead>
        <tbody>
          {rangos.map(r => (
            <tr>
              <th scope="row">{cantidad(r)}</th>
              <td>${r.precio_basico}</td>
              <td>${r.precio_nfc}</td>
              <td>{r.nota || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Ventana>
    <div class="grid grid--ancho" style="margin-top:1.25rem">
      <Ventana titulo="Cómo funciona">
        <ol class="pasos">
          <li>Me escribes con la cantidad aproximada y qué diseños te gustan.</li>
          <li>Te confirmo precio y fecha. Las cantidades grandes tardan unos días en imprimirse.</li>
          <li>Entrega en el puesto o en un punto acordado. Pagas al recoger.</li>
        </ol>
      </Ventana>
      <Ventana titulo="Lo que sí y lo que no" tono="amarillo">
        <ul>
          <li>Sí puedes mezclar diseños y colores dentro del pedido.</li>
          <li>Los editables con nombre entran en mayoreo si el nombre es el mismo para todas las piezas.</li>
          <li>Un diseño nuevo se cotiza aparte, igual que en menudeo.</li>
        </ul>
      </Ventana>
    </div>
    <div class="acciones" style="margin-top:1.5rem">
      <BotonWhatsApp tipo="mayoreo" texto={`Quiero vender ${marca.marca}`} />
    </div>
  </section>
  <div slot="flotante" class="btn-flotante"><BotonWhatsApp tipo="mayoreo" texto="Continuar ▶ WhatsApp" /></div>
</Base>
<style>
  .mayoreo-cab { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; margin-bottom: 1.5rem; }
</style>
