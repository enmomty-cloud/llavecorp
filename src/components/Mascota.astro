---
// Llavi: la mascota. Una llave con cara y bufanda, dibujada en rejilla de 4 px. Todo original.
interface Props {
  estado?: 'saluda' | 'sorpresa' | 'poder' | 'duerme';
  tamano?: number;
  alt?: string;
}
const { estado = 'saluda', tamano = 120, alt } = Astro.props;
const alto = Math.round(tamano * 128 / 96);
---
<svg
  class={`mascota mascota--${estado}`}
  viewBox="0 0 96 128"
  width={tamano}
  height={alto}
  shape-rendering="crispEdges"
  role={alt ? 'img' : undefined}
  aria-label={alt}
  aria-hidden={alt ? undefined : 'true'}
>
  {estado === 'poder' && (
    <g fill="var(--amarillo)">
      <rect x="4" y="12" width="8" height="4" /><rect x="84" y="12" width="8" height="4" />
      <rect x="0" y="40" width="8" height="4" /><rect x="88" y="40" width="8" height="4" />
      <rect x="8" y="24" width="4" height="8" /><rect x="84" y="24" width="4" height="8" />
    </g>
  )}
  {estado === 'sorpresa' && (
    <g fill="var(--amarillo)">
      <rect x="80" y="0" width="8" height="20" /><rect x="80" y="24" width="8" height="8" />
    </g>
  )}
  {estado === 'duerme' && (
    <g fill="var(--cian)">
      <rect x="72" y="4" width="12" height="4" /><rect x="80" y="8" width="4" height="4" /><rect x="76" y="12" width="4" height="4" /><rect x="72" y="16" width="12" height="4" />
    </g>
  )}
  <!-- cabeza (aro de la llave) -->
  <rect x="16" y="4" width="64" height="56" rx="14" fill="var(--tinta)" />
  <rect x="20" y="8" width="56" height="48" rx="12" fill="var(--fondo)" />
  <!-- ojos -->
  {estado === 'poder' ? (
    <g fill="var(--tinta)">
      <rect x="32" y="30" width="4" height="4" /><rect x="36" y="26" width="4" height="4" /><rect x="40" y="30" width="4" height="4" />
      <rect x="52" y="30" width="4" height="4" /><rect x="56" y="26" width="4" height="4" /><rect x="60" y="30" width="4" height="4" />
    </g>
  ) : estado === 'duerme' ? (
    <g fill="var(--tinta)"><rect x="32" y="30" width="12" height="4" /><rect x="52" y="30" width="12" height="4" /></g>
  ) : (
    <g fill="var(--tinta)">
      <rect x="32" y="24" width="8" height="12" /><rect x="56" y="24" width="8" height="12" />
      <rect x="34" y="26" width="2" height="2" fill="var(--fondo)" /><rect x="58" y="26" width="2" height="2" fill="var(--fondo)" />
    </g>
  )}
  <!-- cachetes -->
  <rect x="26" y="38" width="6" height="4" fill="var(--rojo)" /><rect x="64" y="38" width="6" height="4" fill="var(--rojo)" />
  <!-- boca -->
  {estado === 'sorpresa' ? (
    <rect x="44" y="42" width="8" height="8" fill="var(--tinta)" />
  ) : estado === 'duerme' ? (
    <rect x="44" y="46" width="8" height="2" fill="var(--tinta)" />
  ) : (
    <g fill="var(--tinta)"><rect x="40" y="44" width="4" height="4" /><rect x="44" y="48" width="8" height="4" /><rect x="52" y="44" width="4" height="4" /></g>
  )}
  <!-- bufanda -->
  <rect x="24" y="60" width="48" height="10" fill="var(--rojo)" />
  <rect x="60" y="70" width="10" height="16" fill="var(--rojo)" />
  <!-- cuerpo (vástago) -->
  <rect x="36" y="70" width="24" height="46" fill="var(--tinta)" />
  <rect x="40" y="74" width="16" height="38" fill="var(--fondo)" />
  <!-- dientes (pies) -->
  <rect x="60" y="100" width="12" height="8" fill="var(--tinta)" />
  <rect x="60" y="112" width="16" height="8" fill="var(--tinta)" />
  <!-- brazos -->
  {estado === 'saluda' ? (
    <g fill="var(--tinta)"><rect x="24" y="78" width="12" height="6" /><rect x="72" y="56" width="6" height="22" /><rect x="66" y="76" width="6" height="6" /></g>
  ) : (
    <g fill="var(--tinta)"><rect x="24" y="80" width="12" height="6" /><rect x="60" y="88" width="12" height="6" /></g>
  )}
</svg>
