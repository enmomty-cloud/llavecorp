---
// Adornos de anime en pixel: gota de sudor, signo de sorpresa, venita de enojo, brillo.
interface Props { tipo: 'gota' | 'sorpresa' | 'venita' | 'brillo'; tamano?: number }
const { tipo, tamano = 28 } = Astro.props;
---
<svg class={`emote emote--${tipo}`} viewBox="0 0 24 24" width={tamano} height={tamano} shape-rendering="crispEdges" aria-hidden="true">
  {tipo === 'gota' && (
    <g fill="var(--cian)"><rect x="10" y="2" width="4" height="6"/><rect x="8" y="8" width="8" height="6"/><rect x="6" y="14" width="12" height="6"/><rect x="8" y="20" width="8" height="2"/><rect x="8" y="14" width="2" height="4" fill="#fff"/></g>
  )}
  {tipo === 'sorpresa' && (
    <g fill="var(--amarillo)"><rect x="9" y="2" width="6" height="12"/><rect x="9" y="17" width="6" height="5"/></g>
  )}
  {tipo === 'venita' && (
    <g fill="var(--rojo)"><rect x="4" y="10" width="6" height="4"/><rect x="14" y="10" width="6" height="4"/><rect x="10" y="4" width="4" height="6"/><rect x="10" y="14" width="4" height="6"/></g>
  )}
  {tipo === 'brillo' && (
    <g fill="var(--amarillo)"><rect x="10" y="0" width="4" height="24"/><rect x="0" y="10" width="24" height="4"/><rect x="6" y="6" width="12" height="12" opacity=".6"/></g>
  )}
</svg>
